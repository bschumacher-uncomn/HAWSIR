# Versions the lab node installs. Sourced by the scripts under infra/.
# Zarf, UDS Core and storage chart versions are pinned in their manifests:
# infra/cluster/uds-bundle.yaml and infra/cluster/prereqs/zarf.yaml.

RKE2_VERSION="v1.36.5+rke2r1"
# install.sh from the RKE2_VERSION tag of github.com/rancher/rke2.
RKE2_INSTALL_SHA256="42983c86d1da64a92061d83afb57630cedd69241989f1b0673f3db6c3d92ee6b"

# UDS CLI vendors Zarf v0.89.0, the same version as the init package in the bundle.
UDS_CLI_VERSION="v0.41.0"
UDS_CLI_SHA256="31cd710a3f1154f81767a5268f2c887d9e33fe10b81e45ee4183c810dd5ad308" # uds-cli_v0.41.0_Linux_amd64
