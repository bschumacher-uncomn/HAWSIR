{
  "name": "hawsir",
  "version": "0.11.0",
  "private": true,
  "description": "HAWSIR web app: the watch floor, mission thread, theater, fleet lab and decision log for the mission engine. Reads everything through mission-api.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite --host",
    "dev:api": "npm --prefix mission-api run dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "oscal": "tsx ci/gen-oscal.ts",
    "ai-review": "node ci/ai-review.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "video:capture": "node video/capture.mjs",
    "video:score": "node video/score.mjs",
    "video:render": "node video/render.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/react": "^9.1.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource/chakra-petch": "^5.2.5",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "@react-three/postprocessing": "^3.0.4",
    "@xyflow/react": "^12.8.0",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.15.0",
    "postprocessing": "^6.37.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "three": "^0.177.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.4",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/d3-array": "^3.2.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@types/three": "^0.177.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "puppeteer-core": "23",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  },
  "packageManager": "pnpm@9.3.0"
}
